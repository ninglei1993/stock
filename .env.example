# JQData credentials (https://www.joinquant.com)
JQDATA_USERNAME=your_phone_or_email
JQDATA_PASSWORD=your_password

# Set false when JQData is configured
DEMO_MODE=true

# 0 = 入库聚宽返回的全部概念板块；>0 则只取前 N 个（调试用）
INGEST_MAX_CONCEPTS=0

DATABASE_URL=postgresql+asyncpg://themeradar:themeradar@localhost:5432/themeradar
DATABASE_URL_SYNC=postgresql://themeradar:themeradar@localhost:5432/themeradar
REDIS_URL=redis://localhost:6379/0
