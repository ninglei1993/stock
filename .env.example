# 数据源：auto | jqdata | tushare | demo（仪表盘可切换，会写入 data_source.override.json）
DATA_SOURCE=auto

# JQData credentials (https://www.joinquant.com)
JQDATA_USERNAME=你的聚宽手机号或邮箱
JQDATA_PASSWORD=你的聚宽密码

# Tushare Pro (https://tushare.pro) — 注册后在「个人中心」复制 Token
TUSHARE_TOKEN=你的tushare_token

# 填写真实账号后可将 DEMO_MODE 设为 false
DEMO_MODE=false

# 0 = 入库聚宽返回的全部概念板块；>0 则只取前 N 个（调试用）
# 单次扫描入库的概念数；0=全部(~396，易超聚宽日配额100万条)，免费账号建议 50
INGEST_MAX_CONCEPTS=50

# 聚宽账号可查询的数据区间（按账号权限修改）
JQDATA_DATA_START=2025-02-06
JQDATA_DATA_END=2026-02-13

DATABASE_URL=postgresql+asyncpg://themeradar:themeradar@localhost:5432/themeradar
DATABASE_URL_SYNC=postgresql://themeradar:themeradar@localhost:5432/themeradar
REDIS_URL=redis://localhost:6379/0
